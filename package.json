{
  "name": "memmori",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start --android --clear --localhost",
    "start:qr": "npx expo start --clear",
    "start:lan": "npx expo start --lan --clear",
    "start:tunnel": "npx expo start --tunnel --clear",
    "start:web": "npx expo start --web",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "backend": "cd backend && npm run dev",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:testflight": "eas build --platform ios --profile testflight",
    "submit:ios": "eas submit --platform ios",
    "build:all": "eas build --platform all --profile preview",
    "build:dev": "eas build --platform android --profile development"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.17",
    "expo-location": "~57.0.17",
    "expo-media-library": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^10.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.0"
  },
  "private": true
}
